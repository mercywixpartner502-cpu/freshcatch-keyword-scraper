# FreshCatch configuration — copy to .env and fill in what you use.
# Everything is optional: the app runs fully with none of these set.

# --- Cloud database (production, e.g. on Render) ---
# Leave unset to use the local file database (data/freshcatch.sqlite).
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-token

# --- Telegram notifications ---
# 1) Talk to @BotFather on Telegram -> /newbot -> copy the token.
# 2) Send any message to your new bot, then ask @userinfobot for your chat id.
# TELEGRAM_BOT_TOKEN=123456:ABC-your-token
# TELEGRAM_CHAT_ID=123456789

# --- Optional AI layer (free tiers work: Groq, Google Gemini, OpenRouter) ---
# AI_PROVIDER=gemini            (or openai-compatible)
# AI_API_KEY=your-key
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=gemini-2.0-flash     (provider-dependent)

# --- Dashboard login ---
# Set both to require a username/password sign-in before the dashboard opens.
# Leave unset for an open dashboard (local-only use).
# DASH_USERNAME=admin
# DASH_PASSWORD=change-me
# SESSION_SECRET=                 (long random string that signs the session cookie)

# --- Server ---
# PORT=8787
# HOST=127.0.0.1                (set to 0.0.0.0 on Render)
# SCAN_HOUR=8                   (hour of day, server timezone; Render runs UTC)
# PUBLIC_URL=                   (your deployed URL; enables keep-alive self-ping)
# ACCESS_CODE=                  (legacy option: a shared code instead of username/password)

# --- Region ---
# TRENDS_GEO=US
# NEWS_GEO=US
